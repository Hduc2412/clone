GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=xkld_chatbot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=xkld_knowledge
# Sàn tuyệt đối cho đoạn hợp nhất. Dưới mức này thì coi như kho không có
# nội dung và chatbot từ chối. Xem app/rag/retriever.py để biết vì sao 0.62.
MIN_RETRIEVAL_SCORE=0.65
# Hotline hiện trong câu trả lời dự phòng của chatbot và trong prompt.
# Số dưới đây là số GIẢ. Đặt số thật vào `.env` của máy bạn, đừng sửa tệp này —
# tệp này vào kho mã, và kho mã thì công khai. Xem app/core/config.py.
SUPPORT_PHONE=0000.000.000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=xkld_admin_session
# false khi chạy localhost; đặt true khi chạy HTTPS
AUTH_COOKIE_SECURE=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Quản trị viên
# Tạo bằng: python -m app.auth.create_password_hash
INITIAL_ADMIN_PASSWORD_HASH=replace_with_generated_hash
# Cổng backend khi chạy `python main.py`. Dùng 8020 thay vì 8000 mặc định để
# không đụng ứng dụng khác trên máy. Đổi số này thì phải đổi kèm
# NEXT_PUBLIC_BACKEND_URL trong frontend/.env.local và admin-frontend/.env.local.
API_HOST=127.0.0.1
API_PORT=8020
# Địa chỉ hai frontend được phép gọi vào. Website 3100, hệ thống quản trị 3101.
CORS_ORIGINS=http://localhost:3100,http://localhost:3101

# --- Engine tư vấn (app/advisor) ---
# Hệ tư vấn là hệ chính của đề tài; khung chat hỏi đáp là phần phụ trợ. Khai
# khóa riêng ở đây thì hai bên có hạn mức riêng — chat hết quota, tư vấn vẫn
# chạy. Để trống thì dùng chung GEMINI_API_KEY và ứng dụng ghi một dòng cảnh báo
# lúc gọi lần đầu.
ADVISOR_API_KEY=
ADVISOR_MODEL=gemini-2.5-flash
ADVISOR_TIMEOUT_SECONDS=12
# Tắt thì toàn hệ tư vấn chạy bằng câu ghép sẵn. Điểm số và kết luận không đổi,
# vì chúng chưa bao giờ do mô hình tính.
ADVISOR_ENABLED=true

# Model dự phòng của engine tư vấn. Hạn mức gói miễn phí tính theo
# (dự án, model), nên một model thứ hai trên CÙNG khóa là thêm 20 lượt mỗi
# ngày mà không phải mượn hạn mức của khung chat hay bộ đọc CV.
#
# Chỉ dùng khi model chính không trả lời được. KHÔNG BAO GIỜ dùng vì chốt
# hậu kiểm loại câu trả lời — xem app/advisor/client.py.
#
# Để trống thì không có dự phòng: model chính hết hạn mức là rơi về bản
# ghép sẵn. Vẫn an toàn, chỉ kém hơn.
ADVISOR_MODEL_DU_PHONG=
