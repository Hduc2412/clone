GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=xkld_chatbot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=xkld_knowledge
# Sàn tuyệt đối cho đoạn hợp nhất. Dưới mức này thì coi như kho không có
# nội dung và chatbot từ chối. Xem app/rag/retriever.py để biết vì sao 0.62.
MIN_RETRIEVAL_SCORE=0.65
# Hotline hiện trong câu trả lời dự phòng của chatbot và trong prompt
SUPPORT_PHONE=0971.716.939
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=xkld_admin_session
# false khi chạy localhost; đặt true khi chạy HTTPS
AUTH_COOKIE_SECURE=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Quản trị viên
# Tạo bằng: python -m app.auth.create_password_hash
INITIAL_ADMIN_PASSWORD_HASH=replace_with_generated_hash
# Cổng backend khi chạy `python main.py`. Dùng 8020 thay vì 8000 mặc định để
# không đụng ứng dụng khác trên máy. Đổi số này thì phải đổi kèm
# NEXT_PUBLIC_BACKEND_URL trong frontend/.env.local và admin-frontend/.env.local.
API_HOST=127.0.0.1
API_PORT=8020
# Địa chỉ hai frontend được phép gọi vào. Website 3100, hệ thống quản trị 3101.
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
