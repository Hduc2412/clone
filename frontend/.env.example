# Địa chỉ backend mà trình duyệt gọi tới. Phải khớp API_PORT trong backend/.env.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8020

# Địa chỉ backend mà các thành phần chạy trên máy chủ gọi tới. Chạy trên cùng một
# máy thì không cần đặt; khi đóng gói Docker thì đây là tên service, ví dụ
# http://backend:8020, vì trong mạng nội bộ không có localhost của trình duyệt.
# BACKEND_INTERNAL_URL=http://localhost:8020

# Cổng của chính app này là 3100, đặt trong package.json. Next chọn cổng trước
# khi nạp file .env nên viết PORT ở đây không có tác dụng; muốn đổi tạm thì chạy
# `npm run dev -- -p 4000`.
