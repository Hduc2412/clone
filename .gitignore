# Kết quả nghiệm thu là ảnh chụp của một lần chạy trên một máy, không phải mã
# nguồn. Đưa vào kho thì mỗi lần ai đó chạy lại là một lần xung đột vô nghĩa.
backend/tests/fixtures/chatbot/ket_qua_gan_nhat.json
backend/tests/fixtures/cv/ket_qua_doc_cv.json
backend/tests/fixtures/tu_van/ket_qua_tu_van.json
backend/tests/fixtures/tu_van/ket_qua_agent.json

# Bộ đệm phần chữ đọc từ ảnh trên website công ty. Là dữ liệu dẫn xuất — chạy
# lại bộ nạp là có lại — nhưng nó chép nguyên văn watermark trong ảnh, nên bên
# trong có số hotline ba mươi lần, ba địa chỉ văn phòng và mã số thuế công ty.
#
# Kho mã này công khai. Lịch sử git thì xóa rất khó, mà crawler thu số điện
# thoại đọc GitHub trước cả website. Cái giá phải trả: ai nạp lại kho tri thức
# sẽ tốn lượt gọi mô hình đọc ảnh một lần nữa. Đổi lấy việc không phát tán số
# của một người thật thì rẻ.
backend/data/image_vision_cache.json

# Debug files
debug.html
*.log

# Hồ sơ gốc ứng viên tải lên. Tuyệt đối không đưa vào kho mã: đây là dữ liệu cá
# nhân của người thật (họ tên, số điện thoại, ngày sinh), và lịch sử git thì xóa
# đi rất khó — lỡ commit một lần là còn nằm đó mãi.
backend/storage/

